# Pinned inputs and pipeline outputs are reproduced from manifests, never committed.
# Their provenance lives in the run.json each pipeline writes; see src/amazebio/repro.py.
/data/*
/artifacts/*

# pixi
.pixi/

# keep the directory READMEs, ignore the contents
!/data/README.md
!/artifacts/README.md

# python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# editors / os
.DS_Store
.vscode/
.idea/

# uv is not this project's resolver -- pixi.lock is authoritative.
# A second lockfile in the root invites resolving from the one that pins nothing. D-168.
uv.lock
.venv/
.claude/worktrees/

# A4.5's artefact is the exception, and deliberately so. It is a 1,719-row table of a few
# hundred kilobytes, the results bucket is unreachable from the session that produced it, and
# the write-up cites it per figure — so the repository is its durable home. See
# tasks/A4-5-measure-the-matched-families-occurrence-outside-viruses.md.
!/artifacts/a4-5/
!/artifacts/a4-5/**
